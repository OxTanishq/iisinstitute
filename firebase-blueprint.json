{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user account and RBAC role assignment for IIS Institute personnel.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["ADMIN", "TEACHER", "ACCOUNTANT"] },
        "teacherId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "teacherId", "status", "createdAt", "updatedAt"]
    },
    "InstituteSettings": {
      "title": "InstituteSettings",
      "description": "Institute-wide branding, contact details, and financial reporting preferences.",
      "type": "object",
      "properties": {
        "instituteName": { "type": "string", "minLength": 2, "maxLength": 140 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "tagline": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 80 },
        "receiptPrefix": { "type": "string", "minLength": 1, "maxLength": 16 },
        "defaultDueDay": { "type": "integer" },
        "financialYearStartMonth": { "type": "integer" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["instituteName", "logoUrl", "tagline", "phone", "email", "address", "city", "receiptPrefix", "defaultDueDay", "financialYearStartMonth", "updatedBy", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course offered by IIS Institute with standard monthly fee in integer paise.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "subjectCategory": { "type": "string", "maxLength": 80 },
        "defaultMonthlyFeePaise": { "type": "integer" },
        "durationMonths": { "type": "integer" },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "subjectCategory", "defaultMonthlyFeePaise", "durationMonths", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Instructional cohort tied to a course and assigned teacher.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseName": { "type": "string", "maxLength": 120 },
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "scheduleLabel": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "courseId", "courseName", "teacherId", "teacherUid", "teacherName", "scheduleLabel", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty member profile linked to optional Firebase Auth UID for scoped portal access.",
      "type": "object",
      "properties": {
        "teacherCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "specialization": { "type": "string", "maxLength": 120 },
        "subjects": { "type": "array", "maxLength": 10 },
        "linkedUserUid": { "type": "string", "maxLength": 128 },
        "joinedDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherCode", "fullName", "email", "phone", "specialization", "subjects", "linkedUserUid", "joinedDate", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled IIS Institute student record with fee schedule, guardian info, and assigned teacher.",
      "type": "object",
      "properties": {
        "studentCode": { "type": "string", "minLength": 2, "maxLength": 32 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "primaryCourseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "primaryCourseName": { "type": "string", "maxLength": 120 },
        "courseIds": { "type": "array", "maxLength": 10 },
        "batchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "batchName": { "type": "string", "maxLength": 120 },
        "enrollmentDate": { "type": "string", "maxLength": 16 },
        "monthlyFeePaise": { "type": "integer" },
        "paymentSchedule": { "type": "string", "enum": ["MONTHLY", "QUARTERLY", "CUSTOM"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "ARCHIVED"] },
        "guardianName": { "type": "string", "maxLength": 120 },
        "guardianPhone": { "type": "string", "maxLength": 32 },
        "assignedTeacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedTeacherUid": { "type": "string", "maxLength": 128 },
        "assignedTeacherName": { "type": "string", "maxLength": 120 },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentCode", "fullName", "primaryCourseId", "primaryCourseName", "courseIds", "batchId", "batchName", "enrollmentDate", "monthlyFeePaise", "paymentSchedule", "status", "guardianName", "guardianPhone", "assignedTeacherId", "assignedTeacherUid", "assignedTeacherName", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Course enrollment link supporting multi-course student assignments.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseName": { "type": "string", "maxLength": 120 },
        "batchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedTeacherUid": { "type": "string", "maxLength": 128 },
        "agreedFeePaise": { "type": "integer" },
        "startDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["ACTIVE", "COMPLETED", "DROPPED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "courseId", "courseName", "batchId", "teacherId", "assignedTeacherUid", "agreedFeePaise", "startDate", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Student fee invoice storing gross, discount, net due, verified paid, and balance in integer paise.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "minLength": 3, "maxLength": 48 },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseName": { "type": "string", "maxLength": 120 },
        "batchId": { "type": "string", "maxLength": 128 },
        "billingPeriod": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "grossAmountPaise": { "type": "integer" },
        "discountPaise": { "type": "integer" },
        "netAmountDuePaise": { "type": "integer" },
        "paidAmountPaise": { "type": "integer" },
        "balanceDuePaise": { "type": "integer" },
        "dueDate": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "enum": ["PENDING", "PARTIAL", "PAID", "OVERDUE", "CANCELLED"] },
        "assignedTeacherId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 300 },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "studentId", "studentName", "courseId", "courseName", "batchId", "billingPeriod", "grossAmountPaise", "discountPaise", "netAmountDuePaise", "paidAmountPaise", "balanceDuePaise", "dueDate", "status", "assignedTeacherId", "notes", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Immutable or reversible fee payment record linked to an invoice and student.",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string", "minLength": 3, "maxLength": 48 },
        "idempotencyKey": { "type": "string", "minLength": 6, "maxLength": 96, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "billingPeriod": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "amountPaise": { "type": "integer" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "UPI", "BANK_TRANSFER"] },
        "paymentDate": { "type": "string", "maxLength": 16 },
        "referenceNote": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["COMPLETED", "REVERSED"] },
        "reversalReason": { "type": "string", "maxLength": 200 },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNumber", "idempotencyKey", "invoiceId", "studentId", "studentName", "courseId", "courseName", "billingPeriod", "amountPaise", "paymentMethod", "paymentDate", "referenceNote", "status", "reversalReason", "financeViewerUids", "recordedBy", "createdAt", "updatedAt"]
    },
    "TeacherAgreement": {
      "title": "TeacherAgreement",
      "description": "Compensation agreement with effective dates so historical accruals remain immutable.",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "modelType": { "type": "string", "enum": ["FIXED_SALARY", "PERCENTAGE", "PER_STUDENT", "CUSTOM"] },
        "fixedMonthlyPaise": { "type": "integer" },
        "shareBasisPoints": { "type": "integer" },
        "perStudentPaise": { "type": "integer" },
        "effectiveFrom": { "type": "string", "maxLength": 16 },
        "effectiveTo": { "type": "string", "maxLength": 16 },
        "notes": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "enum": ["ACTIVE", "SUPERSEDED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "teacherUid", "teacherName", "modelType", "fixedMonthlyPaise", "shareBasisPoints", "perStudentPaise", "effectiveFrom", "effectiveTo", "notes", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "TeacherShareAllocation": {
      "title": "TeacherShareAllocation",
      "description": "Accrued teacher revenue share or monthly salary obligation separated from actual cash payout.",
      "type": "object",
      "properties": {
        "agreementId": { "type": "string", "maxLength": 128 },
        "modelTypeSnapshot": { "type": "string", "enum": ["FIXED_SALARY", "PERCENTAGE", "PER_STUDENT", "CUSTOM"] },
        "rateSnapshotLabel": { "type": "string", "maxLength": 120 },
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "invoiceId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "billingPeriod": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "basisAmountPaise": { "type": "integer" },
        "allocatedAmountPaise": { "type": "integer" },
        "status": { "type": "string", "enum": ["ACCRUED", "SETTLED", "REVERSED"] },
        "payoutId": { "type": "string", "maxLength": 128 },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agreementId", "modelTypeSnapshot", "rateSnapshotLabel", "teacherId", "teacherUid", "teacherName", "paymentId", "invoiceId", "studentId", "studentName", "billingPeriod", "basisAmountPaise", "allocatedAmountPaise", "status", "payoutId", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "TeacherPayout": {
      "title": "TeacherPayout",
      "description": "Disbursement transaction settling accrued teacher share obligations.",
      "type": "object",
      "properties": {
        "payoutNumber": { "type": "string", "minLength": 3, "maxLength": 48 },
        "teacherId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "billingPeriod": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "amountPaise": { "type": "integer" },
        "paymentMethod": { "type": "string", "enum": ["CASH", "UPI", "BANK_TRANSFER"] },
        "payoutDate": { "type": "string", "maxLength": 16 },
        "referenceNote": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["PAID", "PENDING", "REVERSED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["payoutNumber", "teacherId", "teacherUid", "teacherName", "billingPeriod", "amountPaise", "paymentMethod", "payoutDate", "referenceNote", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Institute operating expense record in integer paise.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "enum": ["RENT", "UTILITIES", "MARKETING", "MATERIALS", "SOFTWARE", "MAINTENANCE", "OTHER"] },
        "amountPaise": { "type": "integer" },
        "expenseDate": { "type": "string", "maxLength": 16 },
        "billingPeriod": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "paymentMethod": { "type": "string", "enum": ["CASH", "UPI", "BANK_TRANSFER"] },
        "vendorName": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "enum": ["RECORDED", "REVERSED"] },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "amountPaise", "expenseDate", "billingPeriod", "paymentMethod", "vendorName", "notes", "status", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "StudentReport": {
      "title": "StudentReport",
      "description": "Academic performance and attendance evaluation submitted by an assigned teacher or admin.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherUid": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "reportingPeriod": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "maxLength": 7 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "attendancePercent": { "type": "integer" },
        "testMarks": { "type": "integer" },
        "maxMarks": { "type": "integer" },
        "academicProgress": { "type": "string", "enum": ["EXCELLENT", "GOOD", "SATISFACTORY", "NEEDS_ATTENTION"] },
        "strengths": { "type": "string", "maxLength": 400 },
        "areasForImprovement": { "type": "string", "maxLength": 400 },
        "teacherComments": { "type": "string", "maxLength": 600 },
        "submissionDate": { "type": "string", "maxLength": 16 },
        "financeViewerUids": { "type": "array", "maxLength": 10 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "courseId", "courseName", "teacherId", "teacherUid", "teacherName", "reportingPeriod", "subject", "attendancePercent", "testMarks", "maxMarks", "academicProgress", "strengths", "areasForImprovement", "teacherComments", "submissionDate", "financeViewerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit record capturing financial and administrative changes.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "actorRole": { "type": "string", "enum": ["ADMIN", "TEACHER", "ACCOUNTANT"] },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 300 },
        "amountPaise": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "actorRole", "entityType", "entityId", "action", "summary", "amountPaise", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Institute user profile and role assignment isolated to owner and admins."
    },
    "/institute_settings/{settingId}": {
      "schema": { "$ref": "#/entities/InstituteSettings" },
      "description": "Global institute configuration and receipt branding."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Catalog of courses offered by IIS Institute."
    },
    "/batches/{batchId}": {
      "schema": { "$ref": "#/entities/Batch" },
      "description": "Instructional batches linking courses and teachers."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Faculty directory and Auth UID links."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student roster with guardian info and assigned teacher."
    },
    "/enrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/Enrollment" },
      "description": "Student-to-course enrollment records."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Monthly and custom student fee invoices."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Verified fee payment ledger in integer paise."
    },
    "/teacher_agreements/{agreementId}": {
      "schema": { "$ref": "#/entities/TeacherAgreement" },
      "description": "Effective-dated teacher compensation agreements."
    },
    "/teacher_share_allocations/{allocationId}": {
      "schema": { "$ref": "#/entities/TeacherShareAllocation" },
      "description": "Accrued teacher revenue share records."
    },
    "/teacher_payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/TeacherPayout" },
      "description": "Actual teacher payout disbursement records."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
