      allow update: if isVerified() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().actorUid == existing().actorUid &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['action', 'summary', 'amountPaise'])
        );

      allow delete: if isVerified() && isValidId(logId) && isAdmin();
    }
  }
