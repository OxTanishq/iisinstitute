          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'subjectCategory', 'defaultMonthlyFeePaise', 'durationMonths', 'status', 'financeViewerUids', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(courseId) && isAdmin();
    }

    // 4. Batches
    match /batches/{batchId} {
      allow get: if isVerified() && isValidId(batchId) && (isFinanceStaff() || existing().teacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().teacherUid == request.auth.uid);

