    // 14. Student Performance Reports
    match /student_reports/{reportId} {
      allow get: if isVerified() && isValidId(reportId) && (isAdmin() || existing().teacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().teacherUid == request.auth.uid);

      allow create: if isVerified() && isValidId(reportId) && isValidStudentReport(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        (
          isAdmin() ||
          (isTeacher() &&
            incoming().teacherUid == request.auth.uid &&
            get(/databases/$(database)/documents/students/$(incoming().studentId)).data.assignedTeacherUid == request.auth.uid)
