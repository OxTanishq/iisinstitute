    }

    // 15. Audit Logs (Editable & Deletable strictly by Admin)
    match /audit_logs/{logId} {
      allow get: if isVerified() && isValidId(logId) && isAdmin();
      allow list: if isVerified() && (isBootstrappedOwner() || existing().actorUid == request.auth.uid);

      allow create: if isVerified() && isValidId(logId) && isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
