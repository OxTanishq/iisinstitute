      allow update: if isVerified() && isValidId(payoutId) && isValidTeacherPayout(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
