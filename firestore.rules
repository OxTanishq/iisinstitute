        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId)) &&
        exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
        isAdmin();

      allow update: if isVerified() && isValidId(batchId) && isValidBatch(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'courseId', 'courseName', 'teacherId', 'teacherUid', 'teacherName', 'scheduleLabel', 'status', 'financeViewerUids', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(batchId) && isAdmin();
    }

    // 5. Teachers
    match /teachers/{teacherId} {
      allow get: if isVerified() && isValidId(teacherId) && (isFinanceStaff() || existing().linkedUserUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().linkedUserUid == request.auth.uid);

      allow create: if isVerified() && isValidId(teacherId) && isValidTeacher(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerified() && isValidId(teacherId) && isValidTeacher(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['teacherCode', 'fullName', 'email', 'phone', 'specialization', 'subjects', 'linkedUserUid', 'joinedDate', 'status', 'financeViewerUids', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(teacherId) && isAdmin();
    }

    // 6. Students
    match /students/{studentId} {
      allow get: if isVerified() && isValidId(studentId) && (isFinanceStaff() || existing().assignedTeacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().assignedTeacherUid == request.auth.uid);

      allow create: if isVerified() && isValidId(studentId) && isValidStudent(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/courses/$(incoming().primaryCourseId)) &&
        exists(/databases/$(database)/documents/batches/$(incoming().batchId)) &&
        exists(/databases/$(database)/documents/teachers/$(incoming().assignedTeacherId)) &&
        isAdmin();

      allow update: if isVerified() && isValidId(studentId) && isValidStudent(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['studentCode', 'fullName', 'primaryCourseId', 'primaryCourseName', 'courseIds', 'batchId', 'batchName', 'enrollmentDate', 'monthlyFeePaise', 'paymentSchedule', 'status', 'guardianName', 'guardianPhone', 'assignedTeacherId', 'assignedTeacherUid', 'assignedTeacherName', 'financeViewerUids', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(studentId) && isAdmin();
    }

    // 7. Enrollments
    match /enrollments/{enrollmentId} {
      allow get: if isVerified() && isValidId(enrollmentId) && (isFinanceStaff() || existing().assignedTeacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().assignedTeacherUid == request.auth.uid);

      allow create: if isVerified() && isValidId(enrollmentId) && isValidEnrollment(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId)) &&
        isAdmin();

      allow update: if isVerified() && isValidId(enrollmentId) && isValidEnrollment(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'courseId', 'courseName', 'batchId', 'teacherId', 'assignedTeacherUid', 'agreedFeePaise', 'startDate', 'status', 'financeViewerUids', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(enrollmentId) && isAdmin();
    }

    // 8. Invoices (Strictly Admin & Accountant; Teachers blocked)
    match /invoices/{invoiceId} {
      allow get: if isVerified() && isValidId(invoiceId) && isFinanceStaff();
      allow list: if isVerified() && isAuthorizedFinanceListViewer();

      allow create: if isVerified() && isValidId(invoiceId) && isValidInvoice(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        isFinanceStaff();

      allow update: if isVerified() && isValidId(invoiceId) && isValidInvoice(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isAccountant() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['courseId', 'courseName', 'billingPeriod', 'grossAmountPaise', 'discountPaise', 'netAmountDuePaise', 'paidAmountPaise', 'balanceDuePaise', 'dueDate', 'status', 'notes', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(invoiceId) && isFinanceStaff();
    }

    // 9. Payments (Editable & Deletable by Finance Staff with strict validation)
    match /payments/{paymentId} {
      allow get: if isVerified() && isValidId(paymentId) && isFinanceStaff();
      allow list: if isVerified() && (
        isBootstrappedOwner() ||
        existing().recordedBy == request.auth.uid ||
        (request.auth.uid in existing().financeViewerUids)
      );

      allow create: if isVerified() && isValidId(paymentId) && isValidPayment(incoming()) &&
        incoming().recordedBy == request.auth.uid &&
        incoming().status == 'COMPLETED' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/invoices/$(incoming().invoiceId)) &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId)) &&
        isFinanceStaff();

      allow update: if isVerified() && isValidId(paymentId) && isValidPayment(incoming()) &&
        incoming().recordedBy == existing().recordedBy &&
        incoming().idempotencyKey == existing().idempotencyKey &&
        incoming().invoiceId == existing().invoiceId &&
        incoming().studentId == existing().studentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isAccountant() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['amountPaise', 'paymentMethod', 'paymentDate', 'billingPeriod', 'referenceNote', 'status', 'reversalReason', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(paymentId) && isFinanceStaff();
    }

    // 10. Teacher Agreements
    match /teacher_agreements/{agreementId} {
      allow get: if isVerified() && isValidId(agreementId) && (isFinanceStaff() || existing().teacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().teacherUid == request.auth.uid);

      allow create: if isVerified() && isValidId(agreementId) && isValidTeacherAgreement(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
        isAdmin();

      allow update: if isVerified() && isValidId(agreementId) && isValidTeacherAgreement(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().teacherId == existing().teacherId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['modelType', 'fixedMonthlyPaise', 'shareBasisPoints', 'perStudentPaise', 'effectiveFrom', 'effectiveTo', 'notes', 'status', 'teacherUid', 'teacherName', 'financeViewerUids', 'updatedAt'])
        );

      allow delete: if isVerified() && isValidId(agreementId) && isAdmin();
    }

    // 11. Teacher Share Allocations
    match /teacher_share_allocations/{allocationId} {
      allow get: if isVerified() && isValidId(allocationId) && (isFinanceStaff() || existing().teacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().teacherUid == request.auth.uid);

      allow create: if isVerified() && isValidId(allocationId) && isValidTeacherShareAllocation(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
