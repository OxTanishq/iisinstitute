          isAdmin() ||
          (isAccountant() &&
            incoming().teacherId == existing().teacherId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['billingPeriod', 'amountPaise', 'paymentMethod', 'payoutDate', 'referenceNote', 'status', 'updatedAt']))
        );

      allow delete: if isVerified() && isValidId(payoutId) && isFinanceStaff();
    }

    // 13. Expenses
    match /expenses/{expenseId} {
      allow get: if isVerified() && isValidId(expenseId) && isFinanceStaff();
      allow list: if isVerified() && isAuthorizedFinanceListViewer();

      allow create: if isVerified() && isValidId(expenseId) && isValidExpense(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().status == 'RECORDED' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isFinanceStaff();

      allow update: if isVerified() && isValidId(expenseId) && isValidExpense(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isAccountant() &&
