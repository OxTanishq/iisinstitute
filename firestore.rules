    // 12. Teacher Payouts
    match /teacher_payouts/{payoutId} {
      allow get: if isVerified() && isValidId(payoutId) && (isFinanceStaff() || existing().teacherUid == request.auth.uid);
      allow list: if isVerified() && (isAuthorizedFinanceListViewer() || existing().teacherUid == request.auth.uid);

      allow create: if isVerified() && isValidId(payoutId) && isValidTeacherPayout(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/teachers/$(incoming().teacherId)) &&
